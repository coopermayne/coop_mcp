# Copy to `.env` (git-ignored) and fill in. The web app auto-loads `.env` at
# startup; shell-exported vars always take precedence over what's here.

# Enables the in-app AI chat at /chat. Without this, chat stays off and the rest
# of the read-only app runs normally.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model for the chat agent loop. Defaults to claude-sonnet-4-6.
# CHAT_MODEL=claude-sonnet-4-6

# Strong random token that unlocks the backup download (GET /export/journal.db)
# for a headless cron `curl` without a browser login. Generate with
# `openssl rand -hex 32`. Unset = backup is browser/session-only. See README
# "Backup & restore".
# BACKUP_TOKEN=

# Strong random token that unlocks TODAY'S MACROS (GET /api/today.json) for an
# ambient display — the SwiftBar menu-bar plugin in scripts/swiftbar/, a phone
# widget. Generate with `openssl rand -hex 32`. Its OWN token on purpose, never
# BACKUP_TOKEN: this one ends up on every device that wants a glanceable number,
# and BACKUP_TOKEN downloads the whole journal. Unset = session-only. See README
# "Menu-bar macros".
# WIDGET_TOKEN=

# Journal lock — a second, local gate (a "secret knock" tap-rhythm) on top of
# Google auth, so someone who picks up the already-signed-in device can't scroll
# the journal. Guards ONLY the journal (entries/people/pending + journal chat);
# trainer and drinking stay open. Set JOURNAL_LOCK=1 to turn it on; the first
# journal visit then asks you to record a knock. Stays on once a knock exists.
# JOURNAL_LOCK=1
# Optional digit-code fallback so a fumbled rhythm never locks you out (unset =
# knock only). Optional auto-relock idle window in seconds (default 300) and the
# per-beat match tolerance (default 0.15).
# JOURNAL_LOCK_PIN=2468
# JOURNAL_LOCK_IDLE=300
# JOURNAL_LOCK_TOLERANCE=0.15

# --- Telegram bots (webapp/telegram.py) -------------------------------------
# Four bots — journal / intake / notes / trainer — each a front end on the same
# agent loop the in-app chat uses, narrowed to one domain. Off unless TELEGRAM_MODE
# is set; a bot whose token is unset simply does not start, so you can ship one at
# a time. Setup (BotFather, the numeric id, webhook vs polling): README "Telegram".
# TELEGRAM_MODE=polling            # webhook (prod) | polling (dev) | off (default)
# TELEGRAM_TOKEN_INTAKE=123456:AA...
# TELEGRAM_TOKEN_JOURNAL=
# TELEGRAM_TOKEN_NOTES=
# TELEGRAM_TOKEN_TRAINER=
#
# WHO MAY TALK TO THEM — numeric Telegram user ids, comma-separated. This is the
# ONLY identity gate on the bots (the webhook is public by necessity; Telegram
# carries no Google session), so it FAILS CLOSED: empty means the bots talk to
# nobody. Get yours from @userinfobot; it's the same id for all four.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
#
# Proves an inbound webhook is really Telegram. Required in webhook mode.
# Generate with `openssl rand -hex 32`.
# TELEGRAM_WEBHOOK_SECRET=
#
# Note: photos sent to a bot are passed to the model and NOT stored anywhere.
#
# Optional: scheduled nudges — comma-separated `bot@HH:MM`, Pacific. This is the
# one thing Telegram can do that the connectors and the PWA can't: start the
# conversation. Each nudge is a real agent turn that reads the day out of the DB
# and MAY DECLINE to say anything, so a quiet day stays quiet. Unset = no nudges
# (a bot that messages you first is opt-in).
# TELEGRAM_NUDGES=intake@16:00,journal@21:00
#
# Optional: seconds after which a bot deletes its OWN replies. Telegram is a
# transport; the record lives in SQLite. Halves the at-rest exposure rather than
# eliminating it — your own typed messages stay in the cloud thread.
# TELEGRAM_REPLY_TTL=

# notes_geocode's User-Agent for OpenStreetMap's Nominatim (free, no key).
# The default is generic; Nominatim's policy asks that it identify the caller.
# GEOCODE_USER_AGENT=my-journal/1.0 (me@example.com)

# Handy for local runs against dev data:
# JOURNAL_DB=./journal_dev.db
# PORT=8011
# SHOW_LOGOUT=1
