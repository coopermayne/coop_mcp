# Copy to `.env` (git-ignored) and fill in. The web app auto-loads `.env` at
# startup; shell-exported vars always take precedence over what's here.

# Enables the in-app AI chat at /chat. Without this, chat stays off and the rest
# of the read-only app runs normally.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model for the chat agent loop. Defaults to claude-sonnet-4-6.
# CHAT_MODEL=claude-sonnet-4-6

# Handy for local runs against dev data:
# JOURNAL_DB=./journal_dev.db
# PORT=8011
# SHOW_LOGOUT=1
